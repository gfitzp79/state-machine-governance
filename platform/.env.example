# ---------------------------------------------------------------------------
# Deployment settings. Copy to .env and edit.
#
#   cp .env.example .env
#
# Your governance model - appetite, control families, roles, SLAs - lives in
# config/governance.yml, not here. This file is infrastructure only.
# ---------------------------------------------------------------------------

# --- database --------------------------------------------------------------
POSTGRES_USER=grc
POSTGRES_PASSWORD=grc
POSTGRES_DB=grc

# --- security --------------------------------------------------------------
# CHANGE THIS before the platform is reachable by anyone but you.
#   openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_TTL_MINUTES=720

# --- application -----------------------------------------------------------
ENVIRONMENT=development

# Seeds a demo dataset on first boot so the platform is explorable immediately.
# Set false for a real deployment; it only ever runs against an empty database.
SEED_DEMO_DATA=true

# Port the UI is served on.
WEB_PORT=8080

# Must match however the UI is reached, including the port.
CORS_ORIGINS=http://localhost:8080

# --- governance model ------------------------------------------------------
# Point this at your own file to keep your configuration outside the checkout.
# GOVERNANCE_CONFIG_FILE=/etc/grc/my-organisation.yml
